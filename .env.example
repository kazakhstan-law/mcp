# Copy to .env on the server. Never commit .env.
KZLAW_PUBLIC_URL=https://cyphy.kz/kazakhstan-law/mcp
# Random, server-local: salts the client-IP hash in the call log.
KZLAW_IP_SALT=
# Address the published port binds to. Behind a proxy on another host, bind to the private
# interface it reaches you on, never 0.0.0.0: every connection through docker's port proxy
# arrives from the network gateway, so the gateway is what KZLAW_TRUSTED_PROXIES must name,
# and only a private bind keeps that trust from extending to anyone who can reach the port.
# KZLAW_BIND=100.64.0.8
# KZLAW_TRUSTED_PROXIES=172.28.0.1   # docker network inspect <project>_default -> Gateway
