[Unit]
Description=kazakhstan-law demo bot (Claude Code Channels, Telegram)
After=network-online.target

[Service]
Type=forking
# Outside $HOME on purpose: Claude Code loads every CLAUDE.md from the working directory up,
# and the owner's ~/CLAUDE.md is instructions for his own work, not for this bot.
WorkingDirectory=/srv/kzlaw-demo-bot
# A profile of its own: its login, its plugin and no user-level CLAUDE.md, hooks or MCP servers.
Environment=CLAUDE_CONFIG_DIR=%h/.claude-kzlaw-demo-bot
ExecStart=/usr/bin/tmux new-session -d -s demo-bot "CLAUDE_CONFIG_DIR=%h/.claude-kzlaw-demo-bot %h/.local/bin/claude --channels plugin:telegram@claude-plugins-official"
ExecStop=/usr/bin/tmux kill-session -t demo-bot
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
